# Database
DATABASE_URL=sqlite+aiosqlite:///./content_platform.db

# Tongyi Qianwen (DashScope)
DASHSCOPE_API_KEY=your_api_key_here

# DingDing Robot
DINGDING_WEBHOOK_URL=https://oapi.dingtalk.com/robot/send?access_token=xxx
DINGDING_SECRET=your_secret_here

# Image APIs
UNSPLASH_ACCESS_KEY=your_key_here
PEXELS_API_KEY=your_key_here

# App settings
ENVIRONMENT=development
LOG_LEVEL=INFO
OUTPUT_DIR=./output
ASSETS_DIR=./assets

# Server
HOST=0.0.0.0
PORT=8000

# Scheduler
CRAWL_CRON_HOUR=6
TOPIC_PUSH_CRON_HOUR=7
